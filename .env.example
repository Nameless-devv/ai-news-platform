# ─── AI API (Grok yoki OpenAI) ────────────────────────────
OPENAI_API_KEY=xai-...your-grok-key-here...
OPENAI_BASE_URL=https://api.x.ai/v1
OPENAI_MODEL=grok-3-mini

# OpenAI ishlatmoqchi bo'lsangiz:
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ─── App ──────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-secret
DEBUG=false

# ─── Database ─────────────────────────────────────────────
POSTGRES_PASSWORD=strongpassword123
DATABASE_URL=postgresql+asyncpg://postgres:strongpassword123@db:5432/ainews
DATABASE_SYNC_URL=postgresql://postgres:strongpassword123@db:5432/ainews

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── Frontend ─────────────────────────────────────────────
# For local dev:
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# For production (replace with your domain):
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com
# NEXT_PUBLIC_WS_URL=wss://api.yourdomain.com

# ─── Performance ──────────────────────────────────────────
FETCH_INTERVAL_MINUTES=5
RATE_LIMIT_PER_MINUTE=60
CACHE_TTL=300
